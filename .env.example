# Kairox platform (Arifaa Pack) - every environment variable the code reads.
# Generated from kx.core.settings.CoreSettings (KX_), kx.automation.settings.AutomationSettings (KX_AUTO_),
# arifaa_pack.config.AppSettings (KX_APP_), plus the few variables vendor SDKs and the CMS read directly.
# Copy to .env for local runs. Never commit .env or real credentials. Values shown are the code's defaults,
# except where a line says "local override"; an empty value after '=' means "not set". In AWS these come from Secrets Manager / task definitions (infra/).
# Nested settings use a double underscore: KX_AUTH__ENCRYPTION_KEY = CoreSettings.auth.encryption_key.


# ----------------------------------------------------------------------------------------------------
# Core (KX_*): environment, databases, Redis, logging. Read by every process (kx.core.settings).
KX_ENV=local
KX_COMPANY_CODE=pack
KX_COMPANY_TIMEZONE=Asia/Dubai
KX_BASE_CURRENCY=AED
KX_CRM_DSN=postgresql+asyncpg://crm_app:dev@localhost:5432/crm
KX_AUTOMATION_DSN=postgresql+asyncpg://automation_app:dev@localhost:5432/automation
KX_AGENTS_DSN=postgresql+asyncpg://agents_app:dev@localhost:5432/agents
KX_DB_POOL_SIZE=10
KX_DB_MAX_OVERFLOW=10
KX_DB_STATEMENT_TIMEOUT_MS=15000
KX_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------------------------------
# Staff login (D26, in-house): RS256 signing key and token rules. KX_JWT_PRIVATE_KEY = an RSA private key in PEM
# (newlines as \n); empty in local/test only (a throw-away key is generated). staging/production refuse to start without it.
KX_JWT_ISSUER=http://localhost:8000
KX_JWT_AUDIENCE=kx-crm
KX_JWT_PRIVATE_KEY=  # secret
KX_JWT_KEY_ID=kx-dev-1
KX_JWKS_URL=

# ----------------------------------------------------------------------------------------------------
# Login policy (OPEN_QUESTIONS #50). KX_AUTH__ENCRYPTION_KEY = Fernet key for TOTP seeds:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside local/test.
KX_AUTH__ACCESS_TTL_SECONDS=900
KX_AUTH__REFRESH_TTL_SECONDS=43200
KX_AUTH__MAX_FAILED_ATTEMPTS=5
KX_AUTH__LOCKOUT_MINUTES=15
KX_AUTH__CODE_TTL_SECONDS=600
KX_AUTH__CODE_MAX_TRIES=5
KX_AUTH__ENCRYPTION_KEY=  # secret
KX_AUTH__COOKIE_SECURE=false  # local override (code default true): plain-http localhost cookies
KX_AUTH__COOKIE_DOMAIN=
KX_AUTH__TOTP_ISSUER=Kairox CRM

# ----------------------------------------------------------------------------------------------------
# Signs website session tokens and email unsubscribe links. Long random value.
KX_SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret

# ----------------------------------------------------------------------------------------------------
# AWS (UAE region).
KX_AWS_REGION=me-central-1
KX_S3_BUCKET=kx-local
KX_LOG_LEVEL=INFO
KX_LOG_JSON=true

# ----------------------------------------------------------------------------------------------------
# Automation (KX_AUTO_*): WhatsApp Cloud API (Meta, direct). QUOTE_DELIVERY_MINUTES = D32 wait before the email fallback.
KX_AUTO_WHATSAPP__GRAPH_BASE_URL=https://graph.facebook.com
KX_AUTO_WHATSAPP__GRAPH_VERSION=v23.0
KX_AUTO_WHATSAPP__PHONE_NUMBER_ID=
KX_AUTO_WHATSAPP__ACCESS_TOKEN=  # secret
KX_AUTO_WHATSAPP__APP_SECRET=  # secret
KX_AUTO_WHATSAPP__VERIFY_TOKEN=  # secret
KX_AUTO_WHATSAPP__TEMPLATE_LANGUAGE=en
KX_AUTO_WHATSAPP__QUOTE_DELIVERY_MINUTES=10
KX_AUTO_WHATSAPP__SESSION_HOURS=24

# ----------------------------------------------------------------------------------------------------
# Email, primary sender: Amazon SES (D33). SNS_TOPIC_ARNS as a JSON list, e.g. ["arn:aws:sns:me-central-1:123:ses-events"].
KX_AUTO_SES__FROM_ADDRESS=sales@example.com
KX_AUTO_SES__CONFIGURATION_SET=
KX_AUTO_SES__SNS_TOPIC_ARNS=[]
KX_AUTO_SES__INBOUND_BUCKET=

# ----------------------------------------------------------------------------------------------------
# Email backup sender + buyer-reply inbox: Postmark (D33). Empty token = SES only.
# Inbound webhook URL to give Postmark: https://<user>:<password>@api.<domain>/webhooks/postmark/inbound
KX_AUTO_POSTMARK__SERVER_TOKEN=  # secret
KX_AUTO_POSTMARK__MESSAGE_STREAM=outbound
KX_AUTO_POSTMARK__INBOUND_USER=
KX_AUTO_POSTMARK__INBOUND_PASSWORD=  # secret
KX_AUTO_POSTMARK__TIMEOUT_SECONDS=10.0

# ----------------------------------------------------------------------------------------------------
# Calls: Twilio (staff alert ladder, click-to-call). Telnyx is not wired yet (OPEN_QUESTIONS #55).
KX_AUTO_TWILIO__API_BASE_URL=https://api.twilio.com
KX_AUTO_TWILIO__ACCOUNT_SID=
KX_AUTO_TWILIO__AUTH_TOKEN=  # secret
KX_AUTO_TWILIO__FROM_NUMBER=
KX_AUTO_TWILIO__STATUS_CALLBACK_BASE_URL=http://localhost:8000
KX_AUTO_TWILIO__RING_TIMEOUT_SECONDS=30
KX_AUTO_TWILIO__VOICE=Polly.Joanna
KX_AUTO_TWILIO__LANGUAGE=en-US

# ----------------------------------------------------------------------------------------------------
# Staff alerts (§16): hours and the approved WhatsApp template names.
KX_AUTO_ALERTS__WINDOW_START=08:00
KX_AUTO_ALERTS__WINDOW_END=22:00
KX_AUTO_ALERTS__TIMEZONE=Asia/Dubai
KX_AUTO_ALERTS__APPROVAL_REQUEST_TEMPLATE=approval_request
KX_AUTO_ALERTS__APPROVAL_REMINDER_TEMPLATE=approval_reminder
KX_AUTO_ALERTS__CHANGE_REQUEST_TEMPLATE=change_request
KX_AUTO_ALERTS__ESCALATION_TEMPLATE=approval_escalation
KX_AUTO_ALERTS__NEGOTIATION_PAUSED_TEMPLATE=negotiation_paused
KX_AUTO_ALERTS__NOTICE_TEMPLATE=staff_notice
KX_AUTO_ALERTS__FINAL_QUOTE_TEMPLATE=final_quote_alert
KX_AUTO_ALERTS__THANK_YOU_TEMPLATE=thank_you
KX_AUTO_ALERTS__ORDER_UPDATE_TEMPLATE=order_update
KX_AUTO_ALERTS__REQUIREMENT_SUMMARY_TEMPLATE=requirement_summary

# ----------------------------------------------------------------------------------------------------
# Buyer follow-ups (§16): contact hours, weekly cap, template per step (JSON object).
KX_AUTO_FOLLOWUP__WINDOW_START=09:00
KX_AUTO_FOLLOWUP__WINDOW_END=18:00
KX_AUTO_FOLLOWUP__MAX_PER_WEEK=2
KX_AUTO_FOLLOWUP__DEFAULT_TIMEZONE=Asia/Dubai
KX_AUTO_FOLLOWUP__TEMPLATES={"followup_d2": "followup_1", "followup_d5": "followup_2", "followup_d10": "followup_3", "reorder": "reorder_reminder", "custom": "followup_1"}

# ----------------------------------------------------------------------------------------------------
# Outbound rate limits (Redis token buckets).
KX_AUTO_RATE_LIMIT__RECIPIENT_CAPACITY=6
KX_AUTO_RATE_LIMIT__RECIPIENT_REFILL_PER_MINUTE=2.0
KX_AUTO_RATE_LIMIT__CHANNEL_CAPACITY=60
KX_AUTO_RATE_LIMIT__CHANNEL_REFILL_PER_MINUTE=600.0

# ----------------------------------------------------------------------------------------------------
# §8.1 STOP flow (these three are overwritten at start-up by the CRM settings optout.*).
KX_AUTO_OPTOUT__ASK_REASON=false
KX_AUTO_OPTOUT__LIVE_MINUTES=10
KX_AUTO_OPTOUT__UNCLEAR_ANSWER_HOURS=24

# ----------------------------------------------------------------------------------------------------
# Misc automation. PRICE_SOURCES = JSON list (v2 price scraping, off by default). COMPANY_NAME is set from company.yaml.
KX_AUTO_PRICE_SOURCES=[]
KX_AUTO_HTTP_TIMEOUT_SECONDS=15.0
KX_AUTO_COMPANY_NAME=
KX_AUTO_PUBLIC_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------------------------------
# App (KX_APP_*): API, buckets, CMS link, CORS.
KX_APP_API_PORT=8000
KX_APP_MEDIA_BUCKET=kx-local-media
KX_APP_INBOUND_MAIL_BUCKET=kx-local-inbound-mail
KX_APP_S3_KMS_KEY_ID=
KX_APP_CMS_URL=http://localhost:3000
KX_APP_CMS_API_KEY=  # secret

# ----------------------------------------------------------------------------------------------------
# AI (D27): Claude API, direct (Sonnet 5.5 money turns, Haiku 5.5 the rest).
KX_APP_ANTHROPIC_API_KEY=  # secret
KX_APP_CORS_ORIGINS=["http://localhost:3001"]

# ----------------------------------------------------------------------------------------------------
# Background jobs (D25): Celery broker (empty = KX_REDIS_URL), worker and Beat timings.
KX_APP_CELERY_BROKER_URL=
KX_APP_WORKER_CONCURRENCY=10
KX_APP_BEAT_SWEEP_SECONDS=30.0
KX_APP_RELAY_SECONDS=5.0
KX_APP_CELERY_VISIBILITY_TIMEOUT_SECONDS=7200

# ----------------------------------------------------------------------------------------------------
# Monitoring (D29): Better Stack errors (Sentry SDK DSN), Beat heartbeat URL, Phoenix traces (full OTLP URL,
# e.g. http://phoenix:6006/v1/traces).
KX_APP_SENTRY_DSN=  # secret
KX_APP_SENTRY_ENVIRONMENT=
KX_APP_SENTRY_TRACES_SAMPLE_RATE=0.0
KX_APP_BETTERSTACK_HEARTBEAT_URL=  # secret
KX_APP_PHOENIX_COLLECTOR_ENDPOINT=
KX_APP_PHOENIX_PROJECT=pack

# ----------------------------------------------------------------------------------------------------
# Gemini backup (D27): OFF until the eval suite passes and Arifa agrees; no client library installed yet (OPEN #65).
KX_APP_GEMINI_API_KEY=  # secret
KX_APP_GEMINI_FALLBACK_ENABLED=false

# ----------------------------------------------------------------------------------------------------
# Knowledge search (D28): Qwen3-Embedding-0.6B server, OpenAI-compatible (base URL without /v1). Local: docker compose --profile ai.
KX_APP_EMBEDDING_URL=
KX_APP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
KX_APP_EMBEDDING_API_KEY=  # secret
KX_APP_EMBEDDING_TIMEOUT_SECONDS=2.0

# ----------------------------------------------------------------------------------------------------
# Website (§6, D39): Cloudflare Turnstile secret (required outside local/test) and LiveKit for website voice.
KX_APP_TURNSTILE_SECRET_KEY=  # secret
KX_APP_LIVEKIT_URL=
KX_APP_LIVEKIT_API_KEY=
KX_APP_LIVEKIT_API_SECRET=  # secret

# ----------------------------------------------------------------------------------------------------
# CMS publish webhook HMAC (§7, D22) = the same value as KX_CMS_WEBHOOK_HMAC in the CMS container.
KX_APP_CMS_WEBHOOK_SECRET=  # secret

# ----------------------------------------------------------------------------------------------------
# Vendor order per field from Parameter Store (D30), e.g. /kx/prod/pack/vendors -> /email = "ses,postmark".
KX_APP_VENDOR_ORDER_SSM_PREFIX=

# ----------------------------------------------------------------------------------------------------
# Daily spend caps per company (D34, OPEN_QUESTIONS #52): alert at 80 %, degrade at 100 %.
KX_APP_SPEND_AI_USD_PER_DAY=25
KX_APP_SPEND_VOICE_MINUTES_PER_DAY=840
KX_APP_SPEND_WA_TEMPLATES_PER_DAY=870

# ----------------------------------------------------------------------------------------------------
# Quote / Requirement Summary PDFs (D37): chromium, WeasyPrint as backup.
KX_APP_PDF_RENDERER=chromium
KX_APP_CHROMIUM_PATH=/usr/bin/chromium

# ----------------------------------------------------------------------------------------------------
# Voice backup TTS (Google Chirp 3 HD): service-account JSON, written to a file for the voice worker.
KX_APP_GOOGLE_CREDENTIALS_JSON=  # secret

# ----------------------------------------------------------------------------------------------------
# Migrations (kx migrate): optional overrides.
# KX_DDL_DIR=                      # where db/ddl lives when not next to the app
# KX_MIGRATE_CRM_DSN=              # owner role for DDL (default: KX_CRM_DSN)
# KX_MIGRATE_AUTOMATION_DSN=
# KX_MIGRATE_AGENTS_DSN=

# ----------------------------------------------------------------------------------------------------
# Voice worker (kx voice): the LiveKit Agents plugins read these names directly (D36).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=  # secret
DEEPGRAM_API_KEY=  # secret - speech-to-text, primary
ELEVEN_API_KEY=  # secret - text-to-speech, primary (ElevenLabs Flash)
SONIOX_API_KEY=  # secret - speech-to-text backup
GOOGLE_APPLICATION_CREDENTIALS=  # path; set automatically from KX_APP_GOOGLE_CREDENTIALS_JSON

# ----------------------------------------------------------------------------------------------------
# Container health check (docker/healthcheck.py; set per ECS service in infra/modules/app_services). The image
# runs `kx <command>`; KX_PROCESS only tells the health check whether to probe HTTP.
KX_PROCESS=api  # api | worker | beat | voice | migrate (only api has an HTTP port)
KX_API_PORT=8000  # health check port (falls back to KX_APP_API_PORT)
KX_HEALTH_PATH=/healthz

# ----------------------------------------------------------------------------------------------------
# CMS container (Payload, separate repo/image) - listed so both sides use the same webhook secret.
# DATABASE_URI=postgresql://cms_app:dev@localhost:5432/cms
# PAYLOAD_SECRET=
# KX_CMS_WEBHOOK_HMAC=             # = KX_APP_CMS_WEBHOOK_SECRET
# KX_API_HOOK_URL=http://localhost:8000/webhooks/cms
